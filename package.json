{
  "name": "profitshare",
  "version": "0.1.0",
  "description": "Open-source budgeting, scheduling and profit-share modelling for independent films.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLEFILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build:single && node tools/smoke.mjs",
    "sample": "node tools/make-sample.mjs",
    "browsers": "node tools/browsers.mjs",
    "build:deck-runtime": "node tools/build-deck-runtime.mjs",
    "deck:scratch": "node tools/deck-scratch.mjs",
    "fonts:catalogue": "node tools/make-font-catalogue.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/special-elite": "^5.1.1",
    "@fontsource/work-sans": "^5.1.1",
    "html-to-image": "^1.11.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
