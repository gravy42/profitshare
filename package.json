{
  "name": "profitshare",
  "version": "0.1.0",
  "description": "Open-source budgeting, scheduling and profit-share modelling for independent films.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "SINGLEFILE=1 vite build --outDir dist-single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample": "node tools/make-sample.mjs",
    "browsers": "node tools/browsers.mjs",
    "deck:scratch": "node tools/deck-scratch.mjs",
    "fonts:catalogue": "node tools/make-font-catalogue.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tools/**/*.mjs\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tools/**/*.mjs\" \"*.{ts,mjs}\""
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/special-elite": "^5.1.1",
    "@fontsource/work-sans": "^5.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "playwright": "^1.63.0",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1",
    "xlsx": "^0.18.5"
  }
}
